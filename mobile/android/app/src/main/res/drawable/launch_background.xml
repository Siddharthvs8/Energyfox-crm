<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: shown by Android while the process starts, and replaced
     the moment Flutter paints. Navy with the EnergyFox mark, matching the
     web build's boot screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
