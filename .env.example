# Docker Compose build/runtime values for single-tenant EnergyFox deployment
DB_NAME=energyfox_crm
DB_USER=postgres
DB_PASSWORD=strongpassword

# Frontend (Next.js): single backend base URL.
# In dev use http://localhost:8000; in prod (nginx same-origin) leave blank.
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_PORT=
NEXT_PUBLIC_API_BASE=
